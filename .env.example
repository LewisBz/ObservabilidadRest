# Copy to .env on the VPS and fill in secrets.
#   cp .env.example .env

# --- Grafana (bound to loopback only; do not use 80 or 443) ---
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_SERVER_ROOT_URL=http://127.0.0.1:3000

# Optional Grafana unified-alerting webhook. Leave empty to keep alerts in the UI only.
# Copy grafana/provisioning/alerting/contactpoints.yaml.example to contactpoints.yaml
# and set this URL before enabling a destination.
ALERT_WEBHOOK_URL=

# --- Docker networks ---
# rest-edge is created by the REST gateway. Do not create monitoring_net.
# Compose fails if this network is missing.
MONITORING_NETWORK=rest-edge

# --- Prometheus ---
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=20GB
REST_METRICS_PATH=/metrics

# --- Host GIDs for Alloy (read docker.sock, journal, audit.log) ---
# On the VPS:
#   getent group docker  | cut -d: -f3
#   getent group systemd-journal | cut -d: -f3
#   getent group adm     | cut -d: -f3
DOCKER_GID=999
JOURNAL_GID=101
ADM_GID=4

# --- k6 (compose profile: loadtest). Hits testbackend only, never prodbackend. ---
K6_TARGET=http://testbackend:3000
K6_PATH=/metrics
