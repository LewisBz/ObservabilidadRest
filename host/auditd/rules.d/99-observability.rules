## ObservabilityRest host audit. Loaded with -e 1 (mutable).
## After the rules have been tested on the VPS, lock them with:
##   echo "-e 2" >> /etc/audit/rules.d/99-observability.rules && augenrules --load
## -e 2 requires a reboot to change rules again.

-D

-b 8192
-f 1
--backlog_wait_time 60000
-r 0

## Drop container and kernel-virtual filesystem noise.
-a never,exit -F dir=/var/lib/docker
-a never,exit -F dir=/var/lib/containerd
-a never,exit -F dir=/proc
-a never,exit -F dir=/sys
-a never,exit -F dir=/run/docker

## Identity and sudoers.
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d -p wa -k sudoers

## /etc changes (config).
-w /etc -p wa -k etc_changes

## Logins.
-w /var/log/lastlog -p wa -k logins
-w /var/log/faillog -p wa -k logins
-w /var/log/tallylog -p wa -k logins

## Human execve (interactive/login users). auid unset (4294967295) is typical of containers.
-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=4294967295 -k human_exec
-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=4294967295 -k human_exec

## sudo.
-w /usr/bin/sudo -p x -k sudo_exec

## Mutable until an operator appends -e 2.
-e 1
